[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]

linux.debug.x86_64 =     "res://target/debug/libracer_godot.so"
linux.release.x86_64 =   "res://target/release/libracer_godot.so"
linux.debug.arm64 =      "res://target/debug/libracer_godot.so"
linux.release.arm64 =    "res://target/release/libracer_godot.so"
macos.debug =            "res://target/debug/libracer_godot.dylib"
macos.release =          "res://target/release/libracer_godot.dylib"
windows.debug.x86_64 =   "res://target/debug/racer_godot.dll"
windows.release.x86_64 = "res://target/release/racer_godot.dll"
